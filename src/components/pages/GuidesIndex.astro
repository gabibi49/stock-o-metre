---
import Base from '../../layouts/Base.astro';
import { dict } from '../../i18n';
import { CALC_KEYS, GUIDE_KEYS, pathTo, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = dict(lang);
const m = d.meta.guides;
---

<Base
  lang={lang}
  routeKey="guides"
  title={m.title}
  description={m.description}
  crumbs={[{ label: d.common.nav.guides, href: pathTo('guides', lang) }]}
>
  <div class="container">
    <header class="page-head">
      <h1>{m.heading}</h1>
      <p class="lead">{d.guides.intro}</p>
    </header>
    <ul class="card-grid">
      {GUIDE_KEYS.map((k) => (
        <li>
          <article class="card">
            <h2>
              <a href={pathTo(k, lang)}>{d.meta[k].heading}</a>
            </h2>
            <p>{d.meta[k].description}</p>
          </article>
        </li>
      ))}
    </ul>
    <h2>{d.meta.calculators.heading}</h2>
    <ul class="card-grid">
      {CALC_KEYS.map((k) => (
        <li>
          <div class="card">
            <h3>
              <a href={pathTo(k, lang)}>{d.meta[k].heading}</a>
            </h3>
            <p>{d.calc.cards[k]}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="cta">
      <p>{d.tool.promise}</p>
      <a class="btn" href={pathTo('home', lang)}>
        {d.common.toTool}
      </a>
    </div>
  </div>
</Base>
